{
  "hooks": {
    "enabled": true,
    "events": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__COMMAND__",
              "timeout": 3
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__COMMAND__",
              "timeout": 3
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "__COMMAND__",
              "timeout": 3
            }
          ]
        }
      ]
    }
  }
}
